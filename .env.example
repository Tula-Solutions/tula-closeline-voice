# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576
# The Closeline Region this deployment serves (us|eu|...). Required outside local; local falls back to us.
REGION=us
# The closeline_voice login (local compose password). Required outside local.
DATABASE_URL=postgres://closeline_voice:closeline_voice_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, and the iss and aud every access token carries.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=closeline
# The AWS Region of the queue and bucket (not the Closeline Region).
AWS_REGION=us-east-1
# Bedrock model id for every voice model call (bare anthropic.*); Haiku 5.5 when unset.
# LLM_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# The event queue and the recordings bucket. Required outside local; the endpoints are local only.
# QUEUE_URL=
# JOBS_QUEUE_URL=
# PHONE_HASH_KEY=
# Proxies in front of this service that append to X-Forwarded-For (0 to 3); 1 behind the ALB.
# TRUSTED_PROXY_HOPS=0
# Local only: the Organization the widget's Chat key (pk_local_chat_...) belongs to, and its origins.
# LOCAL_CHAT_ORGANIZATION_ID=org_00000000000000000000000000000000
# LOCAL_CHAT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QUEUE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# Core's origin and the internal bearer secret from core's INTERNAL_API_TOKENS, for Membership, Rep
# and Team lookups. Set both or neither; required outside local (neither = empty in-memory directory).
# CORE_INTERNAL_URL=http://127.0.0.1:3002
# CORE_INTERNAL_TOKEN=
# JSON map of Organization id to the token of its Booking Type link, so the Agent can read free
# times and book through core's public routes (needs CORE_INTERNAL_URL). A credential; unset means
# no booking over HTTP.
# BOOKING_LINK_TOKENS={"org_<32 hex>":"<link token>"}
# The Playbook's origin and internal bearer secret, for the Agent's Document search. Set both or
# neither; required outside local (neither = empty in-memory search). Local secret of the dev stack:
# PLAYBOOK_INTERNAL_URL=http://127.0.0.1:3003
# PLAYBOOK_INTERNAL_TOKEN=local-playbook-internal-secret-not-for-deploys
# Bearer secrets callers of /internal/v1/* present (ADR 0013), comma separated for rotation; each 32
# to 512 characters. Required outside local, where a public default is used when unset.
# INTERNAL_API_TOKENS=
# memory (local only) or twilio. Required outside local.
TELEPHONY_PROVIDER=memory
# With TELEPHONY_PROVIDER=twilio all of these are required. They are credentials: keep them in the
# secret store, never in a file that is committed.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_TWIML_APP_SID=
# ie1 or au1 for a regional account; omit for the US default.
# TWILIO_REGION=
# The public https origin (no path) Twilio calls back on; http is accepted only when local.
# WEBHOOK_BASE_URL=
# AssemblyAI key for the Copilot live Transcript (a secret; local without it uses scripted speakers).
# ASSEMBLYAI_API_KEY=
# How often the Twilio retention purge runs, in ms (twilio only; default 900000 = 15 min).
# TWILIO_PURGE_INTERVAL_MS=900000
# Most Organizations one purge run visits (default 200).
# TWILIO_PURGE_MAX_ORGANIZATIONS=200
# Longest one purge query may run before it is cancelled, in ms (default 10000).
# TWILIO_PURGE_QUERY_TIMEOUT_MS=10000
# How long an inbound Call rings the Reps before it is missed, in ms (default 30000).
# Vendor prices of the Agent's speech loop, micro-cents (a millionth of a cent) per unit. Required
# outside local, where these are the defaults. They only meter cost; confirm them against the invoices.
# STT_PRICE_MICRO_CENTS_PER_SECOND=4000
# TTS_PRICE_MICRO_CENTS_PER_CHARACTER=1500
# LLM_INPUT_PRICE_MICRO_CENTS_PER_TOKEN=30
# LLM_OUTPUT_PRICE_MICRO_CENTS_PER_TOKEN=150
# RING_TIMEOUT_MS=30000
# How long one Rep is rung for a warm Handoff before the next Rep, in ms (default 20000).
# HANDOFF_RING_TIMEOUT_MS=20000
# MISSED_SWEEP_INTERVAL_MS=5000
# MISSED_SWEEP_MAX_ORGANIZATIONS=200
# RECORDING_PURGE_DELAY_MS=86400000
# RECORDING_PURGE_INTERVAL_MS=60000
# RECORDING_PURGE_MAX_ORGANIZATIONS=200
# RECORDING_JOBS_INTERVAL_MS=2000
# RECORDING_MAX_BYTES=536870912
