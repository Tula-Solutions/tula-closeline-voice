# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576
# The Closeline Region this deployment serves (us|eu|...). Required outside local; local falls back to us.
REGION=us
# The closeline_voice login (local compose password). Required outside local.
DATABASE_URL=postgres://closeline_voice:closeline_voice_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, and the iss and aud every access token carries.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=closeline
# The AWS Region of the queue and bucket (not the Closeline Region).
AWS_REGION=us-east-1
# The event queue and the recordings bucket. Required outside local; the endpoints are local only.
# QUEUE_URL=
# QUEUE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# Core's origin and the internal bearer secret from core's INTERNAL_API_TOKENS, for Membership, Rep
# and Team lookups. Set both or neither; required outside local (neither = empty in-memory directory).
# CORE_INTERNAL_URL=http://127.0.0.1:3002
# CORE_INTERNAL_TOKEN=
# memory (local only) or twilio. Required outside local.
TELEPHONY_PROVIDER=memory
# With TELEPHONY_PROVIDER=twilio all of these are required. They are credentials: keep them in the
# secret store, never in a file that is committed.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_TWIML_APP_SID=
# ie1 or au1 for a regional account; omit for the US default.
# TWILIO_REGION=
# The public https origin (no path) Twilio calls back on; http is accepted only when local.
# WEBHOOK_BASE_URL=
# How often the Twilio retention purge runs, in ms (twilio only; default 900000 = 15 min).
# TWILIO_PURGE_INTERVAL_MS=900000
# Most Organizations one purge run visits (default 200).
# TWILIO_PURGE_MAX_ORGANIZATIONS=200
# Longest one purge query may run before it is cancelled, in ms (default 10000).
# TWILIO_PURGE_QUERY_TIMEOUT_MS=10000
